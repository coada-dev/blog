# Hashnode publication host (e.g., yourblog.hashnode.dev)
HASHNODE_PUBLICATION_HOST=listenrightmeow.hashnode.dev

# Kit (formerly ConvertKit) — newsletter subscription backend.
# Generate at Kit dashboard -> Account -> Developer -> + New API Key.
# Server-side only; never exposed to the client.
KIT_API_KEY=
# The numeric form id from Kit. Find it in the URL when editing the form
# (kit.com/forms/{id}/edit) or in the form's embed snippet.
KIT_FORM_ID=

# Canonical site URL. Used for RSS, OG meta, canonical links.
SITE_URL=https://blog.coada.dev
