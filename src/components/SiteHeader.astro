---
interface Props {
  /** Marks the matching nav link as current and updates the section label. */
  current?: 'writing' | 'about';
}
const { current } = Astro.props;
const sectionLabel = current === 'about' ? 'about' : 'writing';
---

<header class="site-head">
  <a class="brand" href="/" aria-label="Coada — home">
    <img src="/assets/coada.svg" alt="Coada" />
    <span class="slash">/</span>
    <span class="section">{sectionLabel}</span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/" {...(current === 'writing' ? { 'aria-current': 'page' } : {})}>Writing</a>
    <a href="/about" {...(current === 'about' ? { 'aria-current': 'page' } : {})}>About</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</header>
