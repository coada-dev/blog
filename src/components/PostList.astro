---
import { formatDateShort, isoDate } from '../lib/format';
import type { PostListNode, SeriesFull } from '../lib/types';

interface Props {
  posts: PostListNode[];
  /** Map of seriesSlug → ordered post list, used to compute "Part N of M". */
  seriesIndex?: Map<string, SeriesFull>;
}

const { posts, seriesIndex } = Astro.props;

function partLabel(post: PostListNode): string | null {
  if (!post.series || !seriesIndex) return null;
  const series = seriesIndex.get(post.series.slug);
  if (!series) return null;
  const ordered = series.posts.edges.map((e) => e.node);
  // Match the ordering rule used by orderSeriesPosts: oldest-first reading order.
  ordered.sort(
    (a, b) => new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime()
  );
  const idx = ordered.findIndex((p) => p.slug === post.slug);
  if (idx === -1) return null;
  return `Part ${idx + 1} of ${ordered.length}`;
}
---

<ol class="post-list" reversed>
  {
    posts.map((post) => {
      const part = partLabel(post);
      return (
        <li>
          <a href={`/${post.slug}`}>
            {post.series ? (
              <span class="title-wrap">
                <span class="title">{post.title}</span>
                <span class="series-tag">
                  <span class="series-tag-label">Series ·</span> {post.series.name}
                  {part && <> · {part}</>}
                </span>
              </span>
            ) : (
              <span class="title">{post.title}</span>
            )}
            <time class="date" datetime={isoDate(post.publishedAt)}>
              {formatDateShort(post.publishedAt)}
            </time>
          </a>
        </li>
      );
    })
  }
</ol>
