---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Optional <main> screen label, used by the design's data-screen-label hook. */
  screenLabel?: string;
  /** Marks the "Writing" nav link as current. */
  navCurrent?: boolean;
  /** OG image URL (e.g. Hashnode cover). */
  ogImage?: string;
  /** OG type — defaults to "website"; set to "article" for posts. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  screenLabel,
  navCurrent = false,
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteUrl = import.meta.env.SITE_URL ?? Astro.site?.toString() ?? 'https://blog.coada.dev';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/assets/coada.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Coada Blog RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <main class="shell" {...(screenLabel ? { 'data-screen-label': screenLabel } : {})}>
      <SiteHeader current={navCurrent} />
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
