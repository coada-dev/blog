---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { author, site } from '../lib/site';
import { buildJsonLd, type ArticleData } from '../lib/jsonld';

interface ArticleMeta {
  publishedAt: string;
  modifiedAt?: string;
  authorName?: string;
  section?: string;
  tags?: { name: string; slug: string }[];
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Optional <main> screen label, used by the design's data-screen-label hook. */
  screenLabel?: string;
  /** Marks a nav link as current and switches the section label in the brand. */
  navCurrent?: 'writing' | 'about';
  /** OG image URL (e.g. Hashnode cover). */
  ogImage?: string;
  /** OG type — defaults to "website"; set to "article" for posts. */
  ogType?: 'website' | 'article';
  /** Article-specific metadata; only used when ogType === 'article'. */
  article?: ArticleMeta;
}

const {
  title,
  description,
  canonical,
  screenLabel,
  navCurrent,
  ogImage,
  ogType = 'website',
  article,
} = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, site.url).toString().replace(/\/$/, '');

const articleData: ArticleData | undefined =
  ogType === 'article' && article && description
    ? {
        url: canonicalUrl,
        title,
        description,
        publishedAt: article.publishedAt,
        modifiedAt: article.modifiedAt,
        image: ogImage,
        section: article.section,
        tags: article.tags?.map((t) => t.name),
      }
    : undefined;

const jsonLd = buildJsonLd(articleData);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={author.name} />
    <link rel="icon" href="/assets/coada.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Coada Blog RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {ogType === 'article' && article && (
      <>
        <meta property="article:published_time" content={article.publishedAt} />
        <meta
          property="article:modified_time"
          content={article.modifiedAt ?? article.publishedAt}
        />
        <meta property="article:author" content={article.authorName ?? author.name} />
        {article.section && (
          <meta property="article:section" content={article.section} />
        )}
        {article.tags?.map((t) => (
          <meta property="article:tag" content={t.name} />
        ))}
      </>
    )}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline>
      // First-touch UTM capture. Persists ?utm_* params from the landing URL
      // into localStorage so the subscribe form can attribute the original
      // campaign even if the reader subscribes from a later page view.
      (() => {
        try {
          const KEY = 'coada_utm';
          if (localStorage.getItem(KEY)) return;
          const p = new URLSearchParams(location.search);
          const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
          const out = {};
          for (const k of keys) {
            const v = p.get(k);
            if (v) out[k] = v;
          }
          if (Object.keys(out).length) {
            out.ts = Date.now();
            out.referrer = document.referrer || null;
            out.landing = location.pathname;
            localStorage.setItem(KEY, JSON.stringify(out));
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <main class="shell" {...(screenLabel ? { 'data-screen-label': screenLabel } : {})}>
      <SiteHeader current={navCurrent} />
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
