---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { fetchAllPosts, fetchAllSeries, fetchSeries } from '../lib/data';
import type { SeriesFull } from '../lib/types';

const posts = await fetchAllPosts();

// Pull every series so we can compute "Part N of M" labels in the listing.
const seriesList = await fetchAllSeries();
const seriesIndex = new Map<string, SeriesFull>();
await Promise.all(
  seriesList.map(async (s) => {
    const full = await fetchSeries(s.slug);
    if (full) seriesIndex.set(s.slug, full);
  })
);

const description = 'Notes on engineering, infrastructure, and the systems we build at Coada.';
---

<BaseLayout
  title="Writing — Coada"
  description={description}
  navCurrent="writing"
  screenLabel="01 Listing"
>
  <p class="lede">
    Notes on engineering — infrastructure, distributed systems, the small choices
    that compound. <em>Mostly written for myself; published in case it helps someone else.</em>
  </p>

  <PostList posts={posts} seriesIndex={seriesIndex} />
</BaseLayout>
